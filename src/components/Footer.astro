---
import Container from "./Container.astro";
import logoWhiteUrl from "../assets/systemizer-logo-white.svg?url";

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Helix by ST", href: "/helix-by-st/" },
  { label: "IT Solutions", href: "/solutions/" },
  { label: "IT Consulting", href: "/it-consulting/" },
  { label: "Success Stories", href: "/success-stories/" },
];

const companyLinks = [
  { label: "About Us", href: "/about-us/" },
  { label: "Clients", href: "/clients/" },
  { label: "Partners", href: "/partners/" },
  { label: "Blog", href: "/blog/" },
  { label: "Contact Us", href: "/contact/" },
];

const socialLinks = [
  {
    label: "Facebook",
    href: "https://www.facebook.com/SystemizerTechnic",
    icon: "M13.5 9H16l.5-3h-3V4.5c0-.9.3-1.5 1.6-1.5H16.6V.2C16.3.2 15.3 0 14.1 0 11.7 0 10 1.5 10 4.3V6H7v3h3v9h3.5V9z",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/systemizer-technic-sdn-bhd",
    icon: "M4.98 3.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0zM.5 8h4v12h-4V8zm7.5 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V20h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V20H8V8z",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@systemizer.technic",
    icon: "M21.6 7.2a2.8 2.8 0 0 0-2-2C17.9 4.8 12 4.8 12 4.8s-5.9 0-7.6.4a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.7.4 7.6.4 7.6.4s5.9 0 7.6-.4a2.8 2.8 0 0 0 2-2A29 29 0 0 0 22 12a29 29 0 0 0-.4-4.8zM10 15.2V8.8L15.2 12 10 15.2z",
  },
];
---

<footer class="bg-brand-ink text-brand-light">
  <!-- brand accent hairline -->
  <div
    class="h-0.5 bg-gradient-to-r from-brand-primary-dark via-brand-accent to-brand-primary"
    aria-hidden="true"
  >
  </div>
  <Container class="py-16">
    <!-- Real brand logo (white variant on dark footer). Final asset audit in Phase 10. -->
    <a
      href="/"
      aria-label="Systemizer Technic — home"
      class="mb-10 inline-block"
    >
      <img
        src={logoWhiteUrl}
        alt="Systemizer Technic"
        width="140"
        height="55"
        class="h-10 w-auto"
      />
    </a>
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Newsletter -->
      <div>
        <h2 class="text-h5 font-normal text-brand-light">Stay informed</h2>
        <p class="mt-3 text-small text-brand-light/80">
          Subscribe to our newsletter to stay informed about latest updates
        </p>
        <!-- Backend wiring (Cloudflare Pages Function + Turnstile) is Phase 7 -->
        <form action="#" method="post" class="mt-4 flex flex-col gap-3">
          <label for="newsletter-email" class="text-small text-brand-light/80">
            Email Address:
          </label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="rounded-md border border-brand-light/20 bg-brand-light/10 px-3 py-2 text-small text-brand-light placeholder:text-brand-light/50 focus-visible:outline-2 focus-visible:outline-brand-primary"
          />
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-md bg-brand-primary px-4 py-2 text-small text-brand-light transition-colors hover:bg-brand-primary-dark"
          >
            Submit
          </button>
        </form>
      </div>

      <!-- Contact + hours -->
      <div>
        <h2 class="text-h5 font-normal text-brand-light">
          Reach out to us for a chat
        </h2>
        <ul class="mt-4 space-y-2 text-small text-brand-light/80">
          <li>
            <a
              href="mailto:hello@systemizerinc.com"
              class="text-brand-light/80 no-underline transition-colors hover:text-brand-primary"
              >hello@systemizerinc.com</a
            >
          </li>
          <li>
            <a
              href="tel:+60356120032"
              class="text-brand-light/80 no-underline transition-colors hover:text-brand-primary"
              >+603-5612 0032</a
            >
          </li>
        </ul>
        <h3
          class="mt-6 text-small font-medium uppercase tracking-wide text-brand-light/60"
        >
          Business hours
        </h3>
        <p class="mt-2 text-small text-brand-light/80">
          Mon - Fri : 09:00 am – 06:00 pm
        </p>
      </div>

      <!-- Quick links -->
      <nav aria-label="Footer quick links">
        <h2
          class="text-small font-medium uppercase tracking-wide text-brand-light/60"
        >
          Quick links
        </h2>
        <ul class="mt-4 space-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-small text-brand-light/80 no-underline transition-colors hover:text-brand-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Company links -->
      <nav aria-label="Footer company links">
        <h2
          class="text-small font-medium uppercase tracking-wide text-brand-light/60"
        >
          Company
        </h2>
        <ul class="mt-4 space-y-2">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-small text-brand-light/80 no-underline transition-colors hover:text-brand-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-brand-light/10 pt-8 sm:flex-row"
    >
      <p class="text-small text-brand-light/60">
        © 2025 Systemizer Technic (200801005926). All rights reserved.
      </p>
      <ul class="flex items-center gap-4" aria-label="Social media links">
        {
          socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Systemizer Technic on ${social.label}`}
                class="text-brand-light/60 transition-colors hover:text-brand-primary"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path d={social.icon} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
