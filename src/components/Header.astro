---
import Container from "./Container.astro";
import MobileMenu from "./MobileMenu";
import { NAV_ITEMS } from "../data/nav";
import logoUrl from "../assets/systemizer-logo.svg?url";

export interface Props {
  /** Current page path, used to mark the active nav item. */
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50">
  <!-- brand accent hairline -->
  <div
    class="h-0.5 bg-gradient-to-r from-brand-primary via-brand-accent to-brand-primary-dark"
    aria-hidden="true"
  >
  </div>
  <div class="border-b border-brand-surface bg-brand-light/95 backdrop-blur">
    <Container>
      <div class="relative flex h-[4.5rem] items-center justify-between gap-8">
        <a
          href="/"
          class="flex items-center no-underline"
          aria-label="Systemizer Technic — home"
        >
          <!-- Real brand logo (blue on light header). Final asset audit in Phase 10. -->
          <img
            src={logoUrl}
            alt="Systemizer Technic"
            width="140"
            height="55"
            class="h-9 w-auto"
          />
        </a>

        <!-- Desktop nav: pure static HTML, zero JS shipped -->
        <nav aria-label="Primary navigation" class="hidden lg:block">
          <ul class="flex items-center gap-0.5">
            {
              NAV_ITEMS.map((item) => (
                <li class={item.children ? "group relative" : "relative"}>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "nav-link relative flex items-center gap-1 rounded-md px-3 py-2 text-small no-underline transition-colors",
                      isActive(item.href)
                        ? "nav-link--active text-brand-primary-dark"
                        : "text-brand-secondary hover:text-brand-primary-dark",
                    ]}
                  >
                    {item.label}
                    {item.children && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="h-3 w-3"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M6 9l6 6 6-6"
                        />
                      </svg>
                    )}
                  </a>
                  {item.children && (
                    <ul class="invisible absolute left-0 top-full z-50 min-w-48 rounded-lg border border-brand-surface bg-brand-light py-2 opacity-0 shadow-xl transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={
                              isActive(child.href) ? "page" : undefined
                            }
                            class:list={[
                              "block border-l-2 border-transparent px-4 py-2 text-small no-underline transition-colors",
                              isActive(child.href)
                                ? "border-brand-primary text-brand-primary-dark"
                                : "text-brand-text hover:border-brand-primary hover:bg-brand-surface hover:text-brand-primary-dark",
                            ]}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- Mobile menu: Preact island. client:idle is used (not client:visible)
             because the hamburger button is always visible in the header, so
             client:visible would hydrate it immediately anyway; client:idle
             defers hydration to a browser idle period instead of competing with
             initial page load, while still guaranteeing the menu works even if
             the user never scrolls. -->
        <MobileMenu items={NAV_ITEMS} client:idle />
      </div>
    </Container>
  </div>
</header>

<style>
  /* Active-link underline that grows in from the left */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 2px;
    background: var(--color-brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  .nav-link:hover::after,
  .nav-link--active::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>
