---
import Container from "./Container.astro";
import MobileMenu from "./MobileMenu";
import { NAV_ITEMS } from "../data/nav";
import logoUrl from "../assets/systemizer-logo.svg?url";

export interface Props {
  /** Current page path, used to mark the active nav item. */
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50">
  <!-- brand accent hairline -->
  <div
    class="h-px bg-gradient-to-r from-brand-primary via-brand-accent to-transparent"
    aria-hidden="true"
  >
  </div>
  <div class="border-b border-brand-line bg-brand-light/90 backdrop-blur-md">
    <Container>
      <div class="flex h-[4.25rem] items-center justify-between gap-8">
        <a
          href="/"
          class="flex items-center no-underline"
          aria-label="Systemizer Technic — home"
        >
          <img
            src={logoUrl}
            alt="Systemizer Technic"
            width="140"
            height="55"
            class="h-8 w-auto"
          />
        </a>

        <!-- Desktop nav: pure static HTML, zero JS shipped -->
        <nav aria-label="Primary navigation" class="hidden lg:block">
          <ul class="flex items-center gap-1">
            {
              NAV_ITEMS.map((item) => (
                <li class={item.children ? "group relative" : "relative"}>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "nav-link relative flex items-center gap-1 rounded-md px-3 py-2 text-small font-medium no-underline transition-colors",
                      isActive(item.href)
                        ? "nav-link--active text-brand-primary-dark"
                        : "text-brand-graphite hover:text-brand-primary-dark",
                    ]}
                  >
                    {item.label}
                    {item.children && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="h-3 w-3 opacity-60 transition-transform duration-200 group-hover:rotate-180"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M6 9l6 6 6-6"
                        />
                      </svg>
                    )}
                  </a>
                  {item.children && (
                    <div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                      <ul class="w-72 overflow-hidden rounded-xl border border-brand-line bg-brand-light p-2 shadow-2xl shadow-brand-secondary/10">
                        {item.children.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              aria-current={
                                isActive(child.href) ? "page" : undefined
                              }
                              class:list={[
                                "group/item block rounded-lg px-3 py-2.5 no-underline transition-colors",
                                isActive(child.href)
                                  ? "bg-brand-surface"
                                  : "hover:bg-brand-surface",
                              ]}
                            >
                              <span
                                class:list={[
                                  "block text-small font-medium",
                                  isActive(child.href)
                                    ? "text-brand-primary-dark"
                                    : "text-brand-secondary group-hover/item:text-brand-primary-dark",
                                ]}
                              >
                                {child.label}
                              </span>
                              {child.description && (
                                <span class="mt-0.5 block text-micro text-brand-text">
                                  {child.description}
                                </span>
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/contact/"
            class="hidden rounded-md bg-brand-secondary px-5 py-2.5 text-small font-medium text-brand-light no-underline transition-colors hover:bg-brand-primary lg:inline-flex"
          >
            Book a consultation
          </a>

          <!-- Mobile menu: Preact island. client:idle defers hydration to a
               browser idle period instead of competing with initial load. -->
          <MobileMenu items={NAV_ITEMS} client:idle />
        </div>
      </div>
    </Container>
  </div>
</header>

<style>
  /* Active-link underline that grows in from the left */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.1rem;
    height: 2px;
    background: var(--color-brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  .nav-link:hover::after,
  .nav-link--active::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>
