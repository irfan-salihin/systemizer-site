---
import { SITE } from "../data/site";

export interface Crumb {
  label: string;
  href: string;
}

export interface Props {
  /** Ordered trail AFTER Home, e.g. [{ label: "Blog", href: "/blog/" }, { label: post }]. */
  items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${SITE.origin}/`,
    },
    ...items.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 2,
      name: crumb.label,
      item: new URL(crumb.href, SITE.origin).href,
    })),
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
