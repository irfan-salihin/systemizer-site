---
export interface Props {
  /** Visual background variant of the section band. */
  variant?: "light" | "surface" | "dark" | "ink";
  class?: string;
  /**
   * Scroll-reveal entrance animation (fade + translate-Y, 400ms) via the
   * site-wide IntersectionObserver script. Default true; hero/top sections
   * that are immediately in view should pass reveal={false}.
   */
  reveal?: boolean;
}

const { variant = "light", class: className = "", reveal = true } = Astro.props;

const variants: Record<string, string> = {
  light: "bg-brand-light text-brand-text",
  surface: "bg-brand-surface text-brand-text",
  dark: "bg-brand-dark text-brand-light [&_h1]:text-brand-light [&_h2]:text-brand-light [&_h3]:text-brand-light [&_h4]:text-brand-light [&_h5]:text-brand-light [&_h6]:text-brand-light",
  // ink: deepest band — near-black navy, used for high-contrast moments
  ink: "bg-brand-ink text-brand-light [&_h1]:text-brand-light [&_h2]:text-brand-light [&_h3]:text-brand-light [&_h4]:text-brand-light [&_h5]:text-brand-light [&_h6]:text-brand-light",
};
---

<section
  class:list={[
    "py-16 md:py-24",
    variants[variant],
    (variant === "dark" || variant === "ink") && "on-dark",
    className,
  ]}
  data-reveal={reveal ? "" : undefined}
>
  <slot />
</section>
