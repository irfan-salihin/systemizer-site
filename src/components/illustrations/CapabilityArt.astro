---
/**
 * CapabilityArt — a compact, deterministic abstract visual used on hub and
 * detail pages to give each capability a distinct technical texture without
 * photography. Five variants, all driven by brand tokens.
 *
 * Decorative (aria-hidden). Inline SVG + CSS only.
 */
export interface Props {
  /** Which motif to render. */
  variant: "infra" | "automation" | "cloud" | "services" | "helix";
  class?: string;
}

const { variant, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 400 260"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  {
    variant === "infra" && (
      <>
        <ellipse cx="200" cy="210" rx="120" ry="14" fill="var(--color-brand-primary)" fill-opacity="0.12" />
        {[0, 1, 2].map((i) => {
          const y = 150 - i * 46;
          return (
            <g>
              <path d={`M120 ${y} L200 ${y + 30} L200 ${y + 48} L120 ${y + 18} Z`} fill="var(--color-brand-primary)" fill-opacity={0.55 - i * 0.12} />
              <path d={`M280 ${y} L200 ${y + 30} L200 ${y + 48} L280 ${y + 18} Z`} fill="var(--color-brand-secondary)" fill-opacity="0.35" />
              <path d={`M200 ${y - 18} L280 ${y} L200 ${y + 30} L120 ${y} Z`} fill="var(--color-brand-primary)" fill-opacity={0.85 - i * 0.15} />
            </g>
          );
        })}
        <line x1="200" y1="60" x2="200" y2="120" stroke="var(--color-brand-light)" stroke-opacity="0.6" stroke-width="2" stroke-dasharray="5 7" class="cap-flow" />
      </>
    )
  }
  {
    variant === "automation" && (
      <>
        {[70, 130, 190].map((y, i) => (
          <g>
            <rect x="60" y={y - 16} width="70" height="32" rx="6" fill="var(--color-brand-primary)" fill-opacity={0.2 + i * 0.15} />
            <rect x="270" y={y - 16} width="70" height="32" rx="6" fill="var(--color-brand-secondary)" fill-opacity="0.28" />
            <path d={`M130 ${y} H270`} stroke="var(--color-brand-primary)" stroke-opacity="0.4" stroke-width="1.5" stroke-dasharray="3 5" />
            <g class="cap-packets">
              <circle r="3.5" fill="var(--color-brand-data)">
                <animateMotion dur={`${3 + i}s`} repeatCount="indefinite" begin={`${i * 0.5}s`} path={`M130 ${y} H270`} />
              </circle>
            </g>
          </g>
        ))}
        <path d="M200 70 V100 M200 130 V160 M200 190 V220" stroke="var(--color-brand-light)" stroke-opacity="0.15" stroke-width="1" />
      </>
    )
  }
  {
    variant === "cloud" && (
      <>
        <path
          d="M130 160 a34 34 0 0 1 6 -67 a44 44 0 0 1 84 -8 a30 30 0 0 1 44 27 a26 26 0 0 1 -6 48 Z"
          fill="var(--color-brand-primary)"
          fill-opacity="0.22"
          stroke="var(--color-brand-primary)"
          stroke-opacity="0.5"
          stroke-width="1.5"
        />
        {[110, 200, 290].map((x, i) => (
          <g>
            <rect x={x - 26} y="196" width="52" height="34" rx="5" fill="var(--color-brand-secondary)" fill-opacity="0.25" stroke="var(--color-brand-primary)" stroke-opacity="0.5" />
            <circle cx={x} cy="213" r="3" fill="var(--color-brand-data)" class="cap-pulse" style={`animation-delay:${i * 0.4}s`} />
            <line x1={x} y1="160" x2={x} y2="196" stroke="var(--color-brand-primary)" stroke-opacity="0.4" stroke-dasharray="3 4" />
          </g>
        ))}
      </>
    )
  }
  {
    variant === "services" && (
      <>
        <circle cx="200" cy="130" r="70" stroke="var(--color-brand-primary)" stroke-opacity="0.3" stroke-width="1.5" />
        <circle cx="200" cy="130" r="46" stroke="var(--color-brand-primary)" stroke-opacity="0.5" stroke-width="1.5" stroke-dasharray="2 6" />
        <circle cx="200" cy="130" r="22" fill="var(--color-brand-primary)" fill-opacity="0.2" stroke="var(--color-brand-primary)" />
        <circle cx="200" cy="130" r="8" fill="var(--color-brand-data)" class="cap-pulse" />
        {[0, 72, 144, 216, 288].map((deg) => {
          const rad = (deg * Math.PI) / 180;
          return (
            <circle cx={200 + 70 * Math.cos(rad)} cy={130 + 70 * Math.sin(rad)} r="7" fill="var(--color-brand-light)" stroke="var(--color-brand-primary)" stroke-width="2" />
          );
        })}
      </>
    )
  }
  {
    variant === "helix" && (
      <>
        <path d="M150 40 C230 90 170 170 250 220" stroke="var(--color-brand-primary)" stroke-opacity="0.7" stroke-width="3" fill="none" stroke-linecap="round" />
        <path d="M250 40 C170 90 230 170 150 220" stroke="var(--color-brand-data)" stroke-opacity="0.7" stroke-width="3" fill="none" stroke-linecap="round" />
        {[80, 130, 180].map((y) => (
          <line x1="165" y1={y} x2="235" y2={y} stroke="var(--color-brand-light)" stroke-opacity="0.25" stroke-width="1.5" />
        ))}
        {[
          { x: 150, y: 40 },
          { x: 250, y: 40 },
          { x: 250, y: 220 },
          { x: 150, y: 220 },
        ].map((n) => (
          <circle cx={n.x} cy={n.y} r="6" fill="var(--color-brand-primary)" stroke="var(--color-brand-light)" stroke-opacity="0.5" stroke-width="2" />
        ))}
      </>
    )
  }
</svg>

<style>
  .cap-flow {
    animation: cap-dash 2.4s linear infinite;
  }
  .cap-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: cap-blink 2s ease-in-out infinite;
  }
  @keyframes cap-dash {
    to {
      stroke-dashoffset: -24;
    }
  }
  @keyframes cap-blink {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cap-flow,
    .cap-pulse {
      animation: none;
    }
    .cap-packets {
      display: none;
    }
  }
</style>
