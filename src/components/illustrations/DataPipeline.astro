---
/**
 * Abstract enterprise-IT illustration: two clouds joined by a data pipeline
 * with packets in flight. Inline SVG, brand-token colors only, decorative.
 */
export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 480 380"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  <!-- left cloud (on-prem) -->
  <path
    d="M110 150 a38 38 0 0 1 38 -38 a30 30 0 0 1 56 -10 a34 34 0 0 1 44 32 a28 28 0 0 1 -10 54 H118 a30 30 0 0 1 -8 -38 Z"
    fill="var(--color-brand-secondary)"
    fill-opacity="0.4"
    stroke="var(--color-brand-primary)"
    stroke-width="2"></path>
  <!-- right cloud (public cloud) -->
  <path
    d="M292 236 a34 34 0 0 1 34 -34 a27 27 0 0 1 50 -9 a30 30 0 0 1 40 29 a25 25 0 0 1 -9 48 H300 a27 27 0 0 1 -8 -34 Z"
    fill="var(--color-brand-primary)"
    fill-opacity="0.2"
    stroke="var(--color-brand-accent)"
    stroke-width="2"></path>
  <!-- pipeline between them -->
  <path
    d="M196 190 C 240 190, 250 210, 296 214"
    stroke="var(--color-brand-primary)"
    stroke-width="2"
    stroke-opacity="0.55"></path>
  <path
    d="M296 226 C 250 230, 240 214, 196 206"
    stroke="var(--color-brand-accent)"
    stroke-width="2"
    stroke-opacity="0.4"
    stroke-dasharray="4 7"></path>
  <!-- packets -->
  <rect
    x="226"
    y="188"
    width="12"
    height="12"
    rx="2.5"
    fill="var(--color-brand-primary)"></rect>
  <rect
    x="252"
    y="200"
    width="12"
    height="12"
    rx="2.5"
    fill="var(--color-brand-accent)"></rect>
  <rect
    x="238"
    y="212"
    width="9"
    height="9"
    rx="2"
    fill="var(--color-brand-surface)"
    stroke="var(--color-brand-primary)"></rect>
  <!-- ground nodes -->
  <circle
    cx="120"
    cy="300"
    r="7"
    fill="var(--color-brand-primary)"
    fill-opacity="0.8"></circle>
  <circle
    cx="360"
    cy="310"
    r="7"
    fill="var(--color-brand-primary)"
    fill-opacity="0.8"></circle>
  <line
    x1="120"
    y1="188"
    x2="120"
    y2="293"
    stroke="var(--color-brand-primary)"
    stroke-opacity="0.3"
    stroke-dasharray="3 6"></line>
  <line
    x1="360"
    y1="270"
    x2="360"
    y2="303"
    stroke="var(--color-brand-primary)"
    stroke-opacity="0.3"
    stroke-dasharray="3 6"></line>
</svg>
