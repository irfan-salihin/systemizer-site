---
/**
 * Abstract illustration for the Vision section: a central hub radiating
 * concentric orbital rings with satellite nodes — "reshape / transformation
 * rippling outward". Inline SVG, brand-token colors, decorative.
 * Includes a slow orbital rotation, disabled under prefers-reduced-motion.
 */
export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// satellite nodes placed on two orbital rings (angles in degrees)
const ring1 = [0, 90, 180, 270].map((deg) => ({
  x: 240 + 95 * Math.cos((deg * Math.PI) / 180),
  y: 190 + 95 * Math.sin((deg * Math.PI) / 180),
}));
const ring2 = [45, 135, 225, 315].map((deg) => ({
  x: 240 + 150 * Math.cos((deg * Math.PI) / 180),
  y: 190 + 150 * Math.sin((deg * Math.PI) / 180),
}));
---

<svg
  viewBox="0 0 480 380"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  <defs>
    <radialGradient id="vision-glow" cx="50%" cy="50%" r="50%">
      <stop
        offset="0%"
        stop-color="var(--color-brand-primary)"
        stop-opacity="0.35"></stop>
      <stop
        offset="100%"
        stop-color="var(--color-brand-primary)"
        stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <!-- ambient glow -->
  <circle cx="240" cy="190" r="175" fill="url(#vision-glow)"></circle>

  <!-- orbital rings -->
  <circle
    cx="240"
    cy="190"
    r="95"
    stroke="var(--color-brand-primary)"
    stroke-opacity="0.35"
    stroke-width="1.5"
    stroke-dasharray="2 7"></circle>
  <circle
    cx="240"
    cy="190"
    r="150"
    stroke="var(--color-brand-accent)"
    stroke-opacity="0.25"
    stroke-width="1.5"></circle>

  <!-- rotating satellites (animation disabled under prefers-reduced-motion) -->
  <g class="vision-orbit vision-orbit--slow">
    {
      ring2.map((n) => (
        <g>
          <line
            x1="240"
            y1="190"
            x2={n.x}
            y2={n.y}
            stroke="var(--color-brand-accent)"
            stroke-opacity="0.3"
            stroke-width="1.5"
          />
          <circle
            cx={n.x}
            cy={n.y}
            r="7"
            fill="var(--color-brand-light)"
            stroke="var(--color-brand-accent)"
            stroke-width="2"
          />
        </g>
      ))
    }
  </g>
  <g class="vision-orbit vision-orbit--fast">
    {
      ring1.map((n) => (
        <g>
          <line
            x1="240"
            y1="190"
            x2={n.x}
            y2={n.y}
            stroke="var(--color-brand-primary)"
            stroke-opacity="0.4"
            stroke-width="1.5"
          />
          <circle
            cx={n.x}
            cy={n.y}
            r="9"
            fill="var(--color-brand-surface)"
            stroke="var(--color-brand-primary)"
            stroke-width="2"
          />
          <circle cx={n.x} cy={n.y} r="3" fill="var(--color-brand-primary)" />
        </g>
      ))
    }
  </g>

  <!-- central hub -->
  <circle
    cx="240"
    cy="190"
    r="34"
    fill="var(--color-brand-primary)"
    fill-opacity="0.15"></circle>
  <circle cx="240" cy="190" r="22" fill="var(--color-brand-primary)"></circle>
  <circle
    cx="240"
    cy="190"
    r="22"
    stroke="var(--color-brand-light)"
    stroke-opacity="0.5"
    stroke-width="1.5"
    fill="none"></circle>
  <circle cx="240" cy="190" r="8" fill="var(--color-brand-light)"></circle>
</svg>

<style>
  .vision-orbit {
    transform-origin: 240px 190px;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .vision-orbit--slow {
    animation-name: vision-spin;
    animation-duration: 60s;
  }
  .vision-orbit--fast {
    animation-name: vision-spin;
    animation-duration: 40s;
    animation-direction: reverse;
  }
  @keyframes vision-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vision-orbit {
      animation: none;
    }
  }
</style>
