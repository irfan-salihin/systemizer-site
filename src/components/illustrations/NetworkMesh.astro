---
/**
 * Abstract enterprise-IT illustration: a network mesh of connected nodes.
 * Inline SVG, brand-token colors only, decorative (aria-hidden).
 */
export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const nodes = [
  { cx: 60, cy: 70, r: 10, primary: true },
  { cx: 220, cy: 40, r: 7, primary: false },
  { cx: 380, cy: 80, r: 12, primary: true },
  { cx: 140, cy: 180, r: 8, primary: false },
  { cx: 300, cy: 200, r: 9, primary: true },
  { cx: 430, cy: 170, r: 6, primary: false },
  { cx: 90, cy: 300, r: 11, primary: true },
  { cx: 250, cy: 320, r: 7, primary: false },
  { cx: 400, cy: 300, r: 10, primary: true },
];

const edges: Array<[number, number]> = [
  [0, 1],
  [1, 2],
  [0, 3],
  [2, 5],
  [3, 4],
  [4, 5],
  [3, 6],
  [4, 7],
  [5, 8],
  [6, 7],
  [7, 8],
  [2, 4],
  [0, 4],
];
---

<svg
  viewBox="0 0 480 380"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  {
    edges.map(([a, b]) => (
      <line
        x1={nodes[a].cx}
        y1={nodes[a].cy}
        x2={nodes[b].cx}
        y2={nodes[b].cy}
        stroke="var(--color-brand-primary)"
        stroke-opacity="0.35"
        stroke-width="1.5"
      />
    ))
  }
  {
    nodes.map((n) => (
      <>
        {n.primary && (
          <circle
            cx={n.cx}
            cy={n.cy}
            r={n.r + 8}
            fill="var(--color-brand-primary)"
            fill-opacity="0.12"
          />
        )}
        <circle
          cx={n.cx}
          cy={n.cy}
          r={n.r}
          fill={
            n.primary
              ? "var(--color-brand-primary)"
              : "var(--color-brand-surface)"
          }
          stroke="var(--color-brand-primary)"
          stroke-width="1.5"
        />
        <circle
          cx={n.cx}
          cy={n.cy}
          r={n.r / 2.5}
          fill="var(--color-brand-light)"
        />
      </>
    ))
  }
</svg>
