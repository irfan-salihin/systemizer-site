---
/**
 * Abstract enterprise-IT illustration: a server rack with status lights and
 * data bars. Inline SVG, brand-token colors only, decorative (aria-hidden).
 */
export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const units = [0, 1, 2, 3, 4];
---

<svg
  viewBox="0 0 480 380"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  <!-- rack frame -->
  <rect
    x="150"
    y="40"
    width="180"
    height="300"
    rx="10"
    stroke="var(--color-brand-primary)"
    stroke-width="2"
    fill="var(--color-brand-secondary)"
    fill-opacity="0.35"></rect>
  {
    units.map((i) => (
      <g>
        <rect
          x="168"
          y={62 + i * 56}
          width="144"
          height="40"
          rx="5"
          fill="var(--color-brand-surface)"
          fill-opacity="0.12"
          stroke="var(--color-brand-primary)"
          stroke-opacity="0.5"
        />
        <rect
          x="180"
          y={76 + i * 56}
          width={54 + (i % 3) * 22}
          height="6"
          rx="3"
          fill="var(--color-brand-primary)"
          fill-opacity="0.75"
        />
        <rect
          x="180"
          y={88 + i * 56}
          width={34 + ((i + 1) % 3) * 16}
          height="4"
          rx="2"
          fill="var(--color-brand-accent)"
          fill-opacity="0.5"
        />
        <circle
          cx="296"
          cy={82 + i * 56}
          r="4"
          fill={
            i % 2 === 0
              ? "var(--color-brand-primary)"
              : "var(--color-brand-warning)"
          }
        />
      </g>
    ))
  }
  <!-- uplink lines leaving the rack -->
  <path
    d="M330 120 C 390 120, 400 90, 440 90"
    stroke="var(--color-brand-primary)"
    stroke-opacity="0.4"
    stroke-width="1.5"
    stroke-dasharray="5 6"></path>
  <path
    d="M330 260 C 390 260, 400 290, 440 290"
    stroke="var(--color-brand-primary)"
    stroke-opacity="0.4"
    stroke-width="1.5"
    stroke-dasharray="5 6"></path>
  <circle cx="444" cy="90" r="5" fill="var(--color-brand-primary)"></circle>
  <circle cx="444" cy="290" r="5" fill="var(--color-brand-primary)"></circle>
</svg>
