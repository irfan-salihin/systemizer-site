---
/**
 * Abstract illustration for the What We Do section: an isometric stack of
 * modular platform layers (infrastructure as composable building blocks),
 * with status dots and a data bus running through the layers.
 * Inline SVG, brand-token colors, decorative.
 */
export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// isometric layer helper: top rhombus + left/right faces
const layers = [
  { y: 250, tone: "var(--color-brand-secondary)", label: "infra" },
  { y: 205, tone: "var(--color-brand-primary)", label: "platform" },
  { y: 160, tone: "var(--color-brand-accent)", label: "services" },
];
---

<svg
  viewBox="0 0 480 380"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  <defs>
    <linearGradient id="stack-side" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-brand-dark)" stop-opacity="0.25"
      ></stop>
      <stop
        offset="100%"
        stop-color="var(--color-brand-dark)"
        stop-opacity="0.55"></stop>
    </linearGradient>
  </defs>

  <!-- ground shadow -->
  <ellipse
    cx="240"
    cy="320"
    rx="170"
    ry="26"
    fill="var(--color-brand-primary)"
    fill-opacity="0.08"></ellipse>

  {
    layers.map((layer) => (
      <g>
        {/* left face */}
        <path
          d={`M120 ${layer.y} L240 ${layer.y + 52} L240 ${layer.y + 84} L120 ${layer.y + 32} Z`}
          fill={layer.tone}
          fill-opacity="0.55"
        />
        {/* right face */}
        <path
          d={`M360 ${layer.y} L240 ${layer.y + 52} L240 ${layer.y + 84} L360 ${layer.y + 32} Z`}
          fill="url(#stack-side)"
        />
        {/* top face */}
        <path
          d={`M240 ${layer.y - 32} L360 ${layer.y} L240 ${layer.y + 52} L120 ${layer.y} Z`}
          fill={layer.tone}
          fill-opacity="0.9"
          stroke="var(--color-brand-light)"
          stroke-opacity="0.35"
          stroke-width="1.5"
        />
        {/* tile detail on the top face */}
        <path
          d={`M240 ${layer.y - 6} L300 ${layer.y + 13} L240 ${layer.y + 32} L180 ${layer.y + 13} Z`}
          fill="var(--color-brand-light)"
          fill-opacity="0.18"
        />
      </g>
    ))
  }

  <!-- vertical data bus piercing the layers -->
  <line
    x1="240"
    y1="96"
    x2="240"
    y2="240"
    stroke="var(--color-brand-light)"
    stroke-opacity="0.7"
    stroke-width="2"
    stroke-dasharray="6 8"
    class="stack-bus"></line>
  <circle
    cx="240"
    cy="90"
    r="9"
    fill="var(--color-brand-primary)"
    stroke="var(--color-brand-light)"
    stroke-width="2"></circle>
  <circle
    cx="240"
    cy="90"
    r="18"
    stroke="var(--color-brand-primary)"
    stroke-opacity="0.5"
    stroke-width="1.5"
    class="stack-pulse"
    fill="none"></circle>

  <!-- floating status dots -->
  <circle cx="150" cy="120" r="5" fill="var(--color-brand-accent)"></circle>
  <circle cx="335" cy="105" r="4" fill="var(--color-brand-primary)"></circle>
  <circle
    cx="365"
    cy="140"
    r="5"
    fill="var(--color-brand-warning)"
    fill-opacity="0.9"></circle>
</svg>

<style>
  .stack-bus {
    animation: stack-flow 2.4s linear infinite;
  }
  .stack-pulse {
    transform-origin: 240px 90px;
    animation: stack-ping 2.4s ease-out infinite;
  }
  @keyframes stack-flow {
    to {
      stroke-dashoffset: -28;
    }
  }
  @keyframes stack-ping {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-bus,
    .stack-pulse {
      animation: none;
    }
  }
</style>
