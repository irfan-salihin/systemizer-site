---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import JsonLdBreadcrumb from "../components/JsonLdBreadcrumb.astro";
import CollectionIcon from "../components/CollectionIcon.astro";
import GradientMesh from "../components/GradientMesh.astro";
import DotGrid from "../components/DotGrid.astro";
import DiagonalLines from "../components/DiagonalLines.astro";

export interface Props {
  title: string;
  description?: string;
  /** Small overline label above the title, e.g. "Solutions" or "Helix by ST". */
  eyebrow?: string;
  tagline?: string;
  ogType?: "website" | "article";
  /** Lucide icon name (from a collection's `icon` field) shown beside the title. */
  icon?: string;
  /** Decorative abstract background for the dark hero band. Default: flat. */
  heroBackground?:
    "flat" | "mesh" | "dots" | "lines" | "mesh-dots" | "mesh-lines";
}

const {
  title,
  description = "",
  eyebrow,
  tagline,
  ogType,
  icon,
  heroBackground = "flat",
} = Astro.props;

// Inner pages render a breadcrumb rooted at Home; the current page is the last item.
const breadcrumbs = [
  ...(eyebrow && eyebrow !== title
    ? [
        {
          label: eyebrow,
          href: `/${eyebrow.toLowerCase().replace(/\s+/g, "-")}/`,
        },
      ]
    : []),
  { label: title, href: Astro.url.pathname },
];
---

<BaseLayout
  title={`${title} - Systemizer Technic`}
  description={description}
  ogType={ogType}
>
  <Fragment slot="head">
    <JsonLdBreadcrumb items={breadcrumbs} />
    <slot name="head" />
  </Fragment>
  <Section
    variant="ink"
    class="relative overflow-hidden py-20 md:py-32"
    reveal={false}
  >
    {
      heroBackground !== "flat" && (
        <>
          {(heroBackground === "mesh" ||
            heroBackground === "mesh-dots" ||
            heroBackground === "mesh-lines") && <GradientMesh />}
          {(heroBackground === "dots" || heroBackground === "mesh-dots") && (
            <DotGrid />
          )}
          {(heroBackground === "lines" || heroBackground === "mesh-lines") && (
            <DiagonalLines />
          )}
        </>
      )
    }
    <Container class="relative">
      {eyebrow && <p class="kicker kicker--on-dark">{eyebrow}</p>}
      <div class="mt-5 flex items-center gap-5">
        {
          icon && (
            <span class="flex h-14 w-14 items-center justify-center rounded-lg bg-brand-light/10 text-brand-light">
              <CollectionIcon name={icon} class="h-7 w-7" />
            </span>
          )
        }
        <h1 class="text-display text-brand-light">{title}</h1>
      </div>
      {
        tagline && (
          <p class="mt-6 max-w-3xl text-h5 text-brand-light/75">{tagline}</p>
        )
      }
    </Container>
  </Section>
  <slot />
</BaseLayout>
