---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import JsonLdBreadcrumb from "../components/JsonLdBreadcrumb.astro";

export interface Props {
  title: string;
  description?: string;
  /** Small overline label above the title, e.g. "Solutions" or "Helix by ST". */
  eyebrow?: string;
  tagline?: string;
  ogType?: "website" | "article";
}

const { title, description = "", eyebrow, tagline, ogType } = Astro.props;

// Inner pages render a breadcrumb rooted at Home; the current page is the last item.
const breadcrumbs = [
  ...(eyebrow && eyebrow !== title
    ? [
        {
          label: eyebrow,
          href: `/${eyebrow.toLowerCase().replace(/\s+/g, "-")}/`,
        },
      ]
    : []),
  { label: title, href: Astro.url.pathname },
];
---

<BaseLayout
  title={`${title} - Systemizer Technic`}
  description={description}
  ogType={ogType}
>
  <Fragment slot="head">
    <JsonLdBreadcrumb items={breadcrumbs} />
    <slot name="head" />
  </Fragment>
  <Section variant="dark" class="py-20 md:py-28">
    <Container>
      {
        eyebrow && (
          <p class="text-small uppercase tracking-widest text-brand-light/70">
            {eyebrow}
          </p>
        )
      }
      <h1 class="mt-2 text-h1">{title}</h1>
      {
        tagline && (
          <p class="mt-4 max-w-3xl text-h5 text-brand-light/80">{tagline}</p>
        )
      }
    </Container>
  </Section>
  <slot />
</BaseLayout>
