---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import JsonLdBreadcrumb from "../components/JsonLdBreadcrumb.astro";
import CollectionIcon from "../components/CollectionIcon.astro";
import DotGrid from "../components/DotGrid.astro";
import DiagonalLines from "../components/DiagonalLines.astro";
import CircuitTrace from "../components/illustrations/CircuitTrace.astro";

export interface Props {
  title: string;
  description?: string;
  /** Small overline label above the title, e.g. "Solutions" or "Helix by ST". */
  eyebrow?: string;
  tagline?: string;
  ogType?: "website" | "article";
  /** Lucide icon name (from a collection's `icon` field) shown beside the title. */
  icon?: string;
  /** Decorative technical background for the dark hero band. Default: flat. */
  heroBackground?: "flat" | "dots" | "lines";
}

const {
  title,
  description = "",
  eyebrow,
  tagline,
  ogType,
  icon,
  heroBackground = "flat",
} = Astro.props;

// Inner pages render a breadcrumb rooted at Home; the current page is the last item.
const breadcrumbs = [
  ...(eyebrow && eyebrow !== title
    ? [
        {
          label: eyebrow,
          href: `/${eyebrow.toLowerCase().replace(/\s+/g, "-")}/`,
        },
      ]
    : []),
  { label: title, href: Astro.url.pathname },
];
---

<BaseLayout
  title={`${title} - Systemizer Technic`}
  description={description}
  ogType={ogType}
>
  <Fragment slot="head">
    <JsonLdBreadcrumb items={breadcrumbs} />
    <slot name="head" />
  </Fragment>
  <Section
    variant="ink"
    class="relative overflow-hidden py-20 md:py-28"
    reveal={false}
  >
    {
      heroBackground !== "flat" && (
        <>
          {heroBackground === "dots" && <DotGrid />}
          {heroBackground === "lines" && <DiagonalLines />}
        </>
      )
    }
    <CircuitTrace
      class="pointer-events-none absolute -right-16 -top-10 w-[32rem] opacity-25"
      flip
    />
    <Container class="relative max-w-4xl">
      {eyebrow && <p class="kicker kicker--on-dark mb-6">{eyebrow}</p>}
      <div class="flex items-start gap-5">
        {
          icon && (
            <span class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-light/10 text-brand-light ring-1 ring-brand-light/15">
              <CollectionIcon name={icon} class="h-6 w-6" />
            </span>
          )
        }
        <h1 class="text-display text-brand-light">{title}</h1>
      </div>
      {
        tagline && (
          <p class="mt-6 max-w-2xl text-h5 text-brand-light/70">{tagline}</p>
        )
      }
    </Container>
  </Section>
  <slot />
</BaseLayout>
