---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import PhotoPending from "../components/PhotoPending.astro";

const values = [
  {
    name: "Leadership",
    text: "We develop people who lead by example — and go beyond to meet every client's need.",
  },
  {
    name: "Integrity",
    text: "Everything we do is grounded in honesty, professionalism, and trust.",
  },
  {
    name: "Teamwork",
    text: "A holistic, collaborative, and inclusive approach runs through everything.",
  },
  {
    name: "Futurist",
    text: "We stay ahead of the curve, turning emerging technology into practical advantage.",
  },
  {
    name: "Passion",
    text: "We care deeply about the work — and about the experience every client has.",
  },
];

const leaders = [
  {
    name: "Hairie Zairel Oh",
    role: "Managing Director",
    email: "hairie@systemizerinc.com",
  },
  {
    name: "Yvonne Thew",
    role: "Director of Finance · Business Management & Administrative Services",
    email: "yvonne.thew@systemizerinc.com",
  },
  {
    name: "Hasnawi Haris",
    role: "Director of Sales",
    email: "mohd-hasnawi@systemizerinc.com",
  },
];
---

<PageLayout
  title="About Us"
  description="Systemizer Technic is one of Malaysia's leading enterprise solutions companies, powered by qualified, experienced IT professionals with over a decade of industry expertise."
>
  <Section variant="light">
    <Container>
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker">The company</p>
          <h2 class="headline-xl mt-5">
            A Malaysian solution integrator, built on engineering.
          </h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="text-h5 text-brand-text">
            Incorporated in 2008, Systemizer Technic has grown into a
            prominent solution integrator for infrastructure systems — today a
            subsidiary of the Setia Ibarat Group.
          </p>
          <p class="mt-4 text-body text-brand-text">
            With an extensive portfolio of technology solutions under one roof,
            we help clients modernise technology, reimagine processes, and
            transform experiences. Our expertise is driven by out-of-the-box
            thinking and deep technical knowledge.
          </p>
          <div class="mt-8">
            <Button href="/contact/">Work with us</Button>
          </div>
        </div>
      </div>

      <PhotoPending
        class="mt-14"
        caption="Office & team photography — pending"
      />
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">What drives us</p>
          <h2 class="headline-xl mt-5">Mission & values</h2>
          <p class="mt-6 text-body text-brand-text">
            Our mission is to be the preferred technology services provider —
            delivering leading-edge, innovative solutions to enterprises, and
            committed to their success from day one.
          </p>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-2xl border border-brand-line bg-brand-line sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
          {
            values.map((v) => (
              <li class="bg-brand-light p-6">
                <h3 class="text-h4 text-brand-secondary">{v.name}</h3>
                <p class="mt-2 text-small text-brand-text">{v.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </Section>

  <Section variant="light">
    <Container>
      <p class="kicker">Leadership</p>
      <h2 class="headline-xl mt-5">The team behind the systems</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          leaders.map((person) => (
            <div class="rounded-2xl border border-brand-line bg-brand-light p-6">
              <PhotoPending aspect="aspect-square" caption="Portrait — pending" />
              <h3 class="mt-5 text-h4 text-brand-secondary">{person.name}</h3>
              <p class="mt-1 text-small text-brand-text">{person.role}</p>
              <p class="mt-3 text-small">
                <a href={`mailto:${person.email}`}>{person.email}</a>
              </p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section variant="ink">
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <h2 class="headline-xl">
            Build your career at Systemizer.
          </h2>
          <p class="mt-6 max-w-2xl text-body text-brand-light/70">
            We are continuously expanding, and treat our people as a vital asset.
            With scale and diversity across industries and technologies, there is
            room to apply your skills and fuel your passion here.
          </p>
        </div>
        <div class="lg:col-span-4">
          <Button href="/contact/">Apply now</Button>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
