---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-MY", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<PageLayout
  title="Blog"
  tagline="News & Articles"
  description="News and articles from Systemizer Technic on enterprise IT, automation, hybrid cloud, disaster recovery, and IT management."
>
  <Section variant="light">
    <Container>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <Card class="flex flex-col">
              <p class="tech-label text-brand-primary-dark">
                {formatDate(post.data.pubDate)}
              </p>
              <h2 class="mt-3 text-h4 text-brand-secondary">
                {post.data.title}
              </h2>
              <p class="mt-3 flex-1 text-small text-brand-text">
                {post.data.description}
              </p>
              <p class="mt-5">
                <a
                  href={`/blog/${post.id}/`}
                  class="inline-flex items-center gap-2 text-small font-medium text-brand-primary-dark no-underline"
                >
                  Read more
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </p>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>
</PageLayout>
