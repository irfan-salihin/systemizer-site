---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-MY", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<PageLayout
  title="Blog"
  tagline="News & Articles"
  description="News and articles from Systemizer Technic on enterprise IT, automation, hybrid cloud, disaster recovery, and IT management."
>
  <Section variant="light">
    <Container>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <Card>
              <h2 class="text-h4">{post.data.title}</h2>
              <p class="mt-1 text-small text-brand-primary">
                {formatDate(post.data.pubDate)}
              </p>
              <p class="mt-3 text-small">{post.data.description}</p>
              <p class="mt-4">
                <Button href={`/blog/${post.id}/`} variant="ghost" class="px-0">
                  Read More »
                </Button>
              </p>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>
</PageLayout>
