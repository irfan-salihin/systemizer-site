---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import ClientWall from "../components/ClientWall";

// Only verified entries render on the live page. The 52 filename-only entries
// (verified: false, MIGRATION FLAG backlog) are intentionally excluded until
// identified — see roadmap Phase 10.
const clients = (await getCollection("clients"))
  .filter((c) => c.data.verified)
  .map((c) => ({
    name: c.data.name,
    logo: c.data.logo,
    industry: c.data.industry ?? "Others",
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Stable industry order: by descending count, "Others" last.
const counts = new Map<string, number>();
for (const c of clients)
  counts.set(c.industry, (counts.get(c.industry) ?? 0) + 1);
const industries = [...counts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name]) => name)
  .filter((name) => name !== "Others")
  .concat(counts.has("Others") ? ["Others"] : []);
---

<PageLayout
  title="Our Clients"
  description="We have had the opportunity to work with clients from various industries, large and small. We treat each client with the same care and attention, to ensure that the service we provide always meets their requirements."
>
  <Section variant="light">
    <Container>
      <p class="max-w-3xl">
        We have had the opportunity to work with clients from various
        industries, large and small. We treat each client with the same care and
        attention, to ensure that the service we provide always meets their
        requirements.
      </p>

      <!-- Filterable logo wall (Preact island, client:visible). SSRs the full
           wall so the page is complete without JS; tabs filter client-side. -->
      <div class="mt-10">
        <ClientWall client:visible clients={clients} industries={industries} />
      </div>
    </Container>
  </Section>
</PageLayout>
