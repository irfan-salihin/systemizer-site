---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";

// Only verified entries render on the live page. The 52 filename-only entries
// (verified: false, MIGRATION FLAG backlog) are intentionally excluded until
// identified — see roadmap Phase 10.
const clients = (await getCollection("clients"))
  .filter((c) => c.data.verified)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const byIndustry = new Map<string, typeof clients>();
for (const client of clients) {
  const key = client.data.industry ?? "Others";
  if (!byIndustry.has(key)) byIndustry.set(key, []);
  byIndustry.get(key)!.push(client);
}
---

<PageLayout
  title="Our Clients"
  description="We have had the opportunity to work with clients from various industries, large and small. We treat each client with the same care and attention, to ensure that the service we provide always meets their requirements."
>
  <Section variant="light">
    <Container>
      <p class="max-w-3xl">
        We have had the opportunity to work with clients from various
        industries, large and small. We treat each client with the same care and
        attention, to ensure that the service we provide always meets their
        requirements.
      </p>
      {
        [...byIndustry.entries()].map(([industry, entries]) => (
          <div class="mt-12">
            <h2 class="text-h3">{industry}</h2>
            <ul class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
              {entries.map((client) => (
                <li class="flex flex-col items-center gap-3 rounded-lg border border-brand-surface bg-brand-light p-4">
                  {/* Placeholder: hotlinked live-site logo; optimized local assets are Phase 6/10 */}
                  <img
                    src={client.data.logo}
                    alt={`${client.data.name} logo`}
                    width="120"
                    height="120"
                    loading="lazy"
                    class="h-20 w-auto object-contain"
                  />
                  <span class="text-center text-small">{client.data.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </Container>
  </Section>
</PageLayout>
