---
import PageLayout from "../layouts/PageLayout.astro";
import JsonLdOrganization from "../components/JsonLdOrganization.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Card from "../components/Card.astro";

const offices = [
  {
    name: "Head Office",
    address:
      "Suite 12-01 & 12-02, Level 12, Southern Tower, SS15 Courtyard, Jln SS 15/4G, SS15, 47500 Subang Jaya, Selangor, Malaysia",
  },
  {
    name: "Johor",
    address:
      "Suite 25.03A, Level 25, Johor Bahru City Square Office Tower, 106-108 Jalan Wong Ah Fook, 80000 Johor Bahru.",
  },
  {
    name: "Sabah",
    address:
      "8-1, 8th Floor, Suria Sabah Shopping Mall, No.1, Jalan Tun Fuad Stephens, 88000 Kota Kinabalu, Sabah.",
  },
];
---

<PageLayout
  title="Contact Us"
  description="Contact Systemizer Technic — email hello@systemizerinc.com, call +603-5612 0032, or visit our offices in Subang Jaya, Johor Bahru, and Kota Kinabalu."
>
  <JsonLdOrganization slot="head" type="LocalBusiness" />
  <Section variant="light">
    <Container>
      <div class="grid gap-6 md:grid-cols-3">
        <Card>
          <h2 class="text-h5">Email us</h2>
          <p class="mt-3 text-small">
            Please feel free to drop us a line. We will respond as soon as
            possible.
          </p>
          <p class="mt-3 text-small">
            <a href="mailto:hello@systemizerinc.com">hello@systemizerinc.com</a>
          </p>
        </Card>
        <Card>
          <h2 class="text-h5">Call any time</h2>
          <p class="mt-3 text-small">
            If you have any enquiries about our services, call us
          </p>
          <p class="mt-3 text-small">
            <a href="tel:+60356120032">+603-5612 0032</a>
          </p>
        </Card>
        <Card>
          <h2 class="text-h5">Customer Support</h2>
          <p class="mt-3 text-small">
            If you are an existing customer and need assistance, contact us at
            this number
          </p>
          <p class="mt-3 text-small">
            <a href="tel:1800810967">1800 810 967</a>
          </p>
        </Card>
      </div>

      <h2 class="mt-12 text-h2">Visit us</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {
          offices.map((office) => (
            <Card>
              <h3 class="text-h5">{office.name}</h3>
              <p class="mt-3 text-small">{office.address}</p>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section variant="surface">
    <Container class="max-w-2xl">
      <h2 class="text-h2">Leave Us a Message</h2>
      <p class="mt-4">
        Start a conversation with us. We are here to answer any question you
        might have.
      </p>

      <!-- Markup only: backend wiring (Cloudflare Pages Function + Turnstile) is
           Phase 7. The submit handler stub below intentionally does nothing. -->
      <form id="contact-form" class="mt-8 space-y-5" action="#" method="post">
        <div>
          <label
            for="contact-name"
            class="mb-1 block text-small font-medium text-brand-secondary"
          >
            Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-md border border-brand-surface bg-brand-light px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-brand-primary"
          />
        </div>
        <div>
          <label
            for="contact-email"
            class="mb-1 block text-small font-medium text-brand-secondary"
          >
            Email
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-md border border-brand-surface bg-brand-light px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-brand-primary"
          />
        </div>
        <div>
          <label
            for="contact-subject"
            class="mb-1 block text-small font-medium text-brand-secondary"
          >
            Subject
          </label>
          <input
            id="contact-subject"
            name="subject"
            type="text"
            required
            class="w-full rounded-md border border-brand-surface bg-brand-light px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-brand-primary"
          />
        </div>
        <div>
          <label
            for="contact-message"
            class="mb-1 block text-small font-medium text-brand-secondary"
          >
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            class="w-full rounded-md border border-brand-surface bg-brand-light px-3 py-2 text-body focus-visible:outline-2 focus-visible:outline-brand-primary"
          ></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-brand-primary px-6 py-3 text-body text-brand-light transition-colors hover:bg-brand-primary-dark"
        >
          Send message
        </button>
      </form>
      <script>
        // Phase 7 stub: prevent navigation until the Pages Function backend exists.
        document
          .getElementById("contact-form")
          ?.addEventListener("submit", (event) => {
            event.preventDefault();
          });
      </script>
    </Container>
  </Section>
</PageLayout>
