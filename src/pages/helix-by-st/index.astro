---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import CollectionIcon from "../../components/CollectionIcon.astro";

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Product subtitles as shown on the live Helix hub page. */
const subtitles: Record<string, string> = {
  "st-overwatch": "Monitoring & Integration Platform",
  "st-truestate": "Configuration Drift Management",
  stacknode: "Virtualisation Platform",
  stackbot: "Automation as a Service",
};
---

<PageLayout
  title="Helix"
  tagline="Intelligence Woven Into Your Infrastructure"
  description="Where enterprise monitoring, configuration integrity, hybrid cloud control, and automation come together in one cohesive and intelligent ecosystem."
  heroBackground="mesh-dots"
>
  <Section variant="light">
    <Container class="max-w-3xl">
      <p>
        Where enterprise monitoring, configuration integrity, hybrid cloud
        control, and automation come together in one cohesive and intelligent
        ecosystem.
      </p>
      <p class="mt-4">
        Today's digital environment is full of moving parts: servers, clouds,
        applications, containers, networks, and mission-critical workloads.
        Complexity is now the norm.
      </p>
      <p class="mt-4">Helix turns that complexity into clarity.</p>
      <p class="mt-4">
        Built on the idea of seamless synthesis, Helix brings four powerful
        solutions together into a single, unified operational experience.
      </p>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <div class="grid gap-6 md:grid-cols-2">
        {
          products.map((product) => (
            <Card>
              <div class="text-brand-primary">
                <CollectionIcon name={product.data.icon} class="h-9 w-9" />
              </div>
              <h3 class="mt-4 text-h4">{product.data.title}</h3>
              {subtitles[product.id] && (
                <p class="mt-1 text-small font-medium text-brand-primary">
                  {subtitles[product.id]}
                </p>
              )}
              <p class="mt-3">{product.data.description}</p>
              <p class="mt-4">
                <Button
                  href={`/helix-by-st/${product.id}/`}
                  variant="ghost"
                  class="px-0"
                >
                  Learn More &gt;
                </Button>
              </p>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  <Section variant="dark">
    <Container class="max-w-3xl text-center">
      <h2 class="text-h2">Helix is the DNA of a self-optimizing enterprise.</h2>
      <p class="mt-4">
        It weaves together every part, turning complexity into clarity and
        fragmentation into unity.
      </p>
      <p class="mt-4">
        It empowers teams to anticipate, act and innovate with confidence.
      </p>
      <p class="mt-4">
        The future of infrastructure is not just automated, it is adaptive,
        orchestrated, and alive.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <Button href="/contact/">Request a Demo Today</Button>
        <Button href="/contact/" variant="ghost" class="text-brand-light">
          Contact Us
        </Button>
      </div>
    </Container>
  </Section>
</PageLayout>
