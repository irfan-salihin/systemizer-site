---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
import CollectionIcon from "../../components/CollectionIcon.astro";
import CircuitTrace from "../../components/illustrations/CircuitTrace.astro";

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Product subtitles as shown on the live Helix hub page. */
const subtitles: Record<string, string> = {
  "st-overwatch": "Monitoring & Integration Platform",
  "st-truestate": "Configuration Drift Management",
  stacknode: "Virtualisation Platform",
  stackbot: "Automation as a Service",
};
---

<PageLayout
  title="Helix"
  tagline="Intelligence Woven Into Your Infrastructure"
  description="Where enterprise monitoring, configuration integrity, hybrid cloud control, and automation come together in one cohesive and intelligent ecosystem."
  heroBackground="dots"
>
  <Section variant="light">
    <Container>
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker">The platform</p>
          <h2 class="headline-xl mt-5">
            Complexity is the norm. Helix turns it into clarity.
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pt-3">
          <p class="text-body text-brand-text">
            Servers, clouds, applications, containers, networks, and
            mission-critical workloads — Helix brings four powerful solutions
            into a single, unified operational experience.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <ol class="grid gap-6 md:grid-cols-2">
        {
          products.map((product, i) => (
            <li class="group relative overflow-hidden rounded-2xl border border-brand-line bg-brand-light p-8 transition-all duration-200 hover:-translate-y-1 hover:border-brand-primary hover:shadow-xl">
              <span
                class="index-numeral absolute right-6 top-5 opacity-40 transition-opacity group-hover:opacity-100"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-dark text-brand-light">
                <CollectionIcon name={product.data.icon} class="h-5 w-5" />
              </div>
              <h2 class="mt-6 text-h3 text-brand-secondary">
                {product.data.title}
              </h2>
              {subtitles[product.id] && (
                <p class="tech-label mt-2 text-brand-primary-dark">
                  {subtitles[product.id]}
                </p>
              )}
              <p class="mt-3 max-w-md text-small text-brand-text">
                {product.data.description}
              </p>
              <p class="mt-6">
                <a
                  href={`/helix-by-st/${product.id}/`}
                  class="inline-flex items-center gap-2 text-small font-medium text-brand-primary-dark no-underline"
                >
                  Learn more
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-200 group-hover:translate-x-1"
                  >
                    &rarr;
                  </span>
                </a>
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section variant="ink" class="relative overflow-hidden">
    <CircuitTrace
      class="pointer-events-none absolute -right-20 -top-12 w-[34rem] opacity-25"
      flip
    />
    <Container class="relative">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <h2 class="headline-xl">
            Helix is the DNA of a
            <span class="headline-accent--on-dark">self-optimizing</span>
            enterprise.
          </h2>
          <p class="mt-6 max-w-2xl text-body text-brand-light/70">
            It weaves together every part — turning fragmentation into unity and
            empowering teams to anticipate, act, and innovate with confidence.
            The future of infrastructure is not just automated; it is adaptive,
            orchestrated, and alive.
          </p>
        </div>
        <div class="flex flex-col gap-4 lg:col-span-4">
          <Button href="/contact/">Request a demo</Button>
          <Button href="/contact/" variant="onDark">Contact us</Button>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
