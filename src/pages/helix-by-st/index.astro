---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import CollectionIcon from "../../components/CollectionIcon.astro";

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Product subtitles as shown on the live Helix hub page. */
const subtitles: Record<string, string> = {
  "st-overwatch": "Monitoring & Integration Platform",
  "st-truestate": "Configuration Drift Management",
  stacknode: "Virtualisation Platform",
  stackbot: "Automation as a Service",
};
---

<PageLayout
  title="Helix"
  tagline="Intelligence Woven Into Your Infrastructure"
  description="Where enterprise monitoring, configuration integrity, hybrid cloud control, and automation come together in one cohesive and intelligent ecosystem."
  heroBackground="mesh-dots"
>
  <Section variant="light">
    <Container class="max-w-3xl">
      <p>
        Where enterprise monitoring, configuration integrity, hybrid cloud
        control, and automation come together in one cohesive and intelligent
        ecosystem.
      </p>
      <p class="mt-4">
        Today's digital environment is full of moving parts: servers, clouds,
        applications, containers, networks, and mission-critical workloads.
        Complexity is now the norm.
      </p>
      <p class="mt-4">Helix turns that complexity into clarity.</p>
      <p class="mt-4">
        Built on the idea of seamless synthesis, Helix brings four powerful
        solutions together into a single, unified operational experience.
      </p>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <ol class="grid gap-6 md:grid-cols-2">
        {
          products.map((product, i) => (
            <li class="group relative overflow-hidden rounded-lg border border-brand-surface bg-brand-light p-8 transition-all duration-200 hover:-translate-y-1 hover:border-brand-primary hover:shadow-xl">
              <span
                class="index-numeral absolute -right-2 -top-4 opacity-60 transition-opacity group-hover:opacity-100"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-brand-dark text-brand-light">
                <CollectionIcon name={product.data.icon} class="h-6 w-6" />
              </div>
              <h3 class="mt-5 text-h3">{product.data.title}</h3>
              {subtitles[product.id] && (
                <p class="mt-1 text-small font-medium uppercase tracking-wider text-brand-primary-dark">
                  {subtitles[product.id]}
                </p>
              )}
              <p class="mt-3">{product.data.description}</p>
              <p class="mt-5">
                <Button
                  href={`/helix-by-st/${product.id}/`}
                  variant="ghost"
                  class="px-0"
                >
                  Learn More &gt;
                </Button>
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section variant="ink">
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <h2 class="headline-xl">
            Helix is the DNA of a
            <span class="headline-accent--on-dark">self-optimizing</span>
            enterprise.
          </h2>
          <p class="mt-6 max-w-2xl text-brand-light/75">
            It weaves together every part, turning complexity into clarity and
            fragmentation into unity. It empowers teams to anticipate, act and
            innovate with confidence. The future of infrastructure is not just
            automated, it is adaptive, orchestrated, and alive.
          </p>
        </div>
        <div class="flex flex-col gap-4 lg:col-span-4">
          <Button href="/contact/">Request a Demo Today</Button>
          <Button href="/contact/" variant="ghost" class="text-brand-light">
            Contact Us
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</PageLayout>
