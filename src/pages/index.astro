---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLdOrganization from "../components/JsonLdOrganization.astro";
import DotGrid from "../components/DotGrid.astro";
import SystemCore from "../components/illustrations/SystemCore.astro";
import TopologyField from "../components/illustrations/TopologyField.astro";
import CircuitTrace from "../components/illustrations/CircuitTrace.astro";
import StatCounter from "../components/StatCounter";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import CollectionIcon from "../components/CollectionIcon.astro";

const solutions = (await getCollection("solutions")).sort(
  (a, b) => a.data.order - b.data.order,
);

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);

const stories = (await getCollection("success-stories"))
  .filter((s) => s.data.featured)
  .slice(0, 3);

const productSubtitles: Record<string, string> = {
  "st-overwatch": "Monitoring & Integration",
  "st-truestate": "Configuration Drift",
  stacknode: "Virtualisation",
  stackbot: "Automation as a Service",
};

const differentiators = [
  {
    title: "One accountable team",
    text: "Infrastructure, cloud, automation, and managed support delivered by a single in-house engineering group — not a chain of subcontractors.",
  },
  {
    title: "Enterprise & government grade",
    text: "Tens of thousands of seats and mission-critical workloads across finance, telco, oil & gas, and the public sector.",
  },
  {
    title: "Vendor-neutral by design",
    text: "Certified across Dell, HPE, Fortinet, Nutanix, Veeam and Red Hat. We recommend what your environment needs, not what a quota requires.",
  },
];

const clients = [
  "AIA",
  "Affin Bank",
  "Bank Islam",
  "TM",
  "LHDN",
  "RHB",
  "Dell",
  "HPE",
];
---

<BaseLayout
  title="Home - Systemizer Technic"
  description="Systemizer Technic engineers and runs enterprise infrastructure, hybrid cloud, and IT automation for Malaysian enterprises and government — securely, continuously, at scale."
>
  <JsonLdOrganization slot="head" type="Organization" />

  <!-- Hero -->
  <Section
    variant="ink"
    class="relative overflow-hidden py-24 md:py-32"
    reveal={false}
  >
    <DotGrid />
    <TopologyField
      class="pointer-events-none absolute inset-0 h-full w-full opacity-50 [mask-image:radial-gradient(ellipse_at_70%_40%,black_20%,transparent_75%)]"
    />
    <Container class="relative">
      <div class="grid items-center gap-14 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker kicker--on-dark">Systemizer Technic</p>
          <h1 class="mt-6 text-mega text-brand-light">
            Enterprise infrastructure,
            <span class="headline-accent--on-dark">engineered end to end.</span>
          </h1>
          <p class="mt-7 max-w-xl text-h5 text-brand-light/70">
            We design, deploy, and run the mission-critical IT that keeps
            Malaysian enterprises and government operating — across on-prem,
            cloud, and everything in between.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <Button href="/contact/">Book a consultation</Button>
            <Button href="/solutions/" variant="onDark">
              Explore solutions
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </Button>
          </div>
          <p class="tech-label mt-10 text-brand-light/40">
            Est. 2008 · Subang Jaya · Johor Bahru · Kota Kinabalu
          </p>
        </div>
        <div class="lg:col-span-6">
          <SystemCore class="mx-auto w-full max-w-lg lg:max-w-none" />
        </div>
      </div>
    </Container>
  </Section>

  <!-- Proof strip: metrics + client wall -->
  <Section variant="light" class="border-b border-brand-line py-14">
    <Container>
      <StatCounter
        client:visible
        stats={[
          {
            value: new Date().getFullYear() - 2008,
            suffix: "+",
            label: "Years in business",
          },
          { value: 64, suffix: "+", label: "Verified clients" },
          { value: 99, suffix: "%", label: "Customer satisfaction" },
          { value: 3, suffix: "", label: "Office locations" },
        ]}
      />

      <div
        class="mt-12 border-t border-brand-line pt-8"
        aria-label="Selected clients"
      >
        <p class="tech-label mb-5 text-center">
          Trusted across finance, government, telco, and industry
        </p>
        <ul
          class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 opacity-60"
        >
          {
            clients.map((name) => (
              <li class="text-h5 font-semibold tracking-tight text-brand-graphite">
                {name}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </Section>

  <!-- Core capabilities -->
  <Section variant="light">
    <Container>
      <div class="max-w-2xl">
        <p class="kicker">Capabilities</p>
        <h2 class="headline-xl mt-5">Four systems. One partner.</h2>
        <p class="mt-5 text-h5 text-brand-text">
          Everything required to build, protect, and run enterprise IT —
          delivered as one integrated stack.
        </p>
      </div>

      <ul class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-brand-line bg-brand-line sm:grid-cols-2 lg:grid-cols-4">
        {
          solutions.map((solution) => (
            <li class="group relative bg-brand-light p-8">
              <a
                href={`/solutions/${solution.id}/`}
                class="flex h-full flex-col no-underline"
              >
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-surface text-brand-primary-dark ring-1 ring-brand-line">
                  <CollectionIcon name={solution.data.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-6 text-h4 text-brand-secondary">
                  {solution.data.title}
                </h3>
                <p class="mt-3 flex-1 text-small text-brand-text">
                  {solution.data.tagline}
                </p>
                <span class="mt-6 inline-flex items-center gap-2 text-small font-medium text-brand-primary-dark">
                  Learn more
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-200 group-hover:translate-x-1"
                  >
                    &rarr;
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  <!-- Why Systemizer -->
  <Section variant="surface">
    <Container>
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">Why Systemizer</p>
          <h2 class="headline-xl mt-5">
            Built for the parts of IT that cannot fail.
          </h2>
          <p class="mt-6 text-body text-brand-text">
            We are the engineering team behind critical systems for some of
            Malaysia's largest organisations — measured on uptime, not slideware.
          </p>
          <div class="mt-8">
            <Button href="/about-us/" variant="secondary">
              About us
            </Button>
          </div>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <ol class="divide-y divide-brand-line border-y border-brand-line">
            {
              differentiators.map((item, i) => (
                <li class="grid grid-cols-[auto_1fr] gap-x-6 py-7">
                  <span
                    class="index-numeral pt-0.5 text-[1.5rem]"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3 class="text-h4 text-brand-secondary">{item.title}</h3>
                    <p class="mt-2 max-w-xl text-small text-brand-text">
                      {item.text}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Helix spotlight -->
  <Section variant="ink" class="relative overflow-hidden">
    <DotGrid />
    <TopologyField
      class="pointer-events-none absolute inset-0 h-full w-full opacity-30 [mask-image:linear-gradient(to_left,black,transparent_60%)]"
    />
    <Container class="relative">
      <div class="grid items-end gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker kicker--on-dark">Helix by ST</p>
          <h2 class="headline-xl mt-5">
            The platform that makes infrastructure
            <span class="headline-accent--on-dark">observable and adaptive.</span>
          </h2>
          <p class="mt-6 max-w-xl text-body text-brand-light/70">
            Four modules that turn fragmented systems into one coherent,
            self-optimising estate.
          </p>
          <div class="mt-8">
            <Button href="/helix-by-st/" variant="onDark">
              Explore Helix
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </Button>
          </div>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-2xl border border-brand-light/15 bg-brand-light/15 sm:grid-cols-2 lg:col-span-6">
          {
            products.map((product) => (
              <li class="bg-brand-ink p-6">
                <a
                  href={`/helix-by-st/${product.id}/`}
                  class="group flex items-start gap-4 no-underline"
                >
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-light/5 text-brand-light ring-1 ring-brand-light/15">
                    <CollectionIcon name={product.data.icon} class="h-5 w-5" />
                  </span>
                  <span>
                    <span class="block text-h5 font-medium text-brand-light">
                      {product.data.title}
                    </span>
                    <span class="tech-label mt-1 block text-brand-light/50">
                      {productSubtitles[product.id]}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </Section>

  <!-- Selected work -->
  <Section variant="light">
    <Container>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="kicker">Selected work</p>
          <h2 class="headline-xl mt-5">Outcomes, not case-study filler.</h2>
        </div>
        <Button href="/success-stories/" variant="secondary">
          All success stories
        </Button>
      </div>

      <ol class="mt-14 grid gap-8 md:grid-cols-3">
        {
          stories.map((story, i) => (
            <li class="group flex flex-col border-t-2 border-brand-secondary pt-6">
              <div class="flex items-start justify-between gap-4">
                <span class="index-numeral" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="tech-label max-w-[55%] text-right">
                  {story.data.industry.split("(")[0].trim()}
                </span>
              </div>
              <h3 class="mt-6 text-h4 text-brand-secondary">
                {story.data.clientName}
              </h3>
              <p class="mt-4 flex-1">
                <span class="block font-heading text-h2 font-semibold text-brand-primary">
                  {story.data.resultStat}
                </span>
                <span class="mt-1 block text-small text-brand-text">
                  {story.data.resultLabel}
                </span>
              </p>
              <a
                href={`/success-stories/${story.data.slug}/`}
                class="mt-6 inline-flex items-center gap-2 text-small font-medium text-brand-primary-dark no-underline"
              >
                Read the story
                <span
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-1"
                >
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <!-- Closing CTA -->
  <Section variant="ink" class="relative overflow-hidden">
    <CircuitTrace class="pointer-events-none absolute -bottom-10 left-0 w-[36rem] opacity-30" />
    <CircuitTrace flip class="pointer-events-none absolute -top-10 right-0 w-[36rem] opacity-30" />
    <Container class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="headline-xl">Let's talk about your infrastructure.</h2>
        <p class="mt-5 text-h5 text-brand-light/70">
          Tell us what you're running today. We'll show you where it can go.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <Button href="/contact/">Book a consultation</Button>
          <Button href="/solutions/" variant="onDark">View solutions</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
