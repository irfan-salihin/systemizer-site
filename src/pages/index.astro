---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLdOrganization from "../components/JsonLdOrganization.astro";
import GradientMesh from "../components/GradientMesh.astro";
import DotGrid from "../components/DotGrid.astro";
import NetworkMesh from "../components/illustrations/NetworkMesh.astro";
import ServerRack from "../components/illustrations/ServerRack.astro";
import DataPipeline from "../components/illustrations/DataPipeline.astro";
import StatCounter from "../components/StatCounter";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";

const stories = await getCollection("success-stories");
const truncate = (s: string, n: number) =>
  s.length > n ? s.slice(0, s.lastIndexOf(" ", n)) + "…" : s;
---

<BaseLayout
  title="Home - Systemizer Technic"
  description="Leading-edge IT technology services custom-tailored for your business. Systemizer Technic specializes in helping companies modernise technology, reimagine processes and transform experiences."
>
  <JsonLdOrganization slot="head" type="Organization" />

  <!-- Hero: asymmetric composition — oversized display type left, illustration
       breaking the grid right, layered brand abstract background -->
  <Section
    variant="ink"
    class="relative overflow-hidden py-24 md:py-36"
    reveal={false}
  >
    <GradientMesh />
    <DotGrid />
    <Container class="relative">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker kicker--on-dark">Systemizer Technic</p>
          <h1 class="mt-5 text-mega text-brand-light">
            Leading-edge IT services,
            <span class="headline-accent--on-dark">custom-tailored</span>
            for your business
          </h1>
          <p class="mt-7 max-w-xl text-h5 text-brand-light/75">
            Systemizer Technic specializes in helping companies modernise
            technology, reimagine processes and transform experiences, so they
            stay ahead of the curve in the fast-changing world.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <Button href="/contact/">Contact Us</Button>
            <Button
              href="/solutions/"
              variant="secondary"
              class="border-brand-light/40 text-brand-light hover:bg-brand-light/10"
            >
              Explore Solutions
            </Button>
          </div>
        </div>
        <div class="lg:col-span-5">
          <NetworkMesh
            class="hidden w-full max-w-md justify-self-end lg:block"
          />
        </div>
      </div>
    </Container>
  </Section>

  <!-- Stats band: real figures — founded 2008 (content-audit/about-us.md),
       verified clients from the clients collection, 99% CSAT (st-services copy),
       3 offices (content-audit/contact-us.md) -->
  <Section variant="light" class="border-b border-brand-surface py-14">
    <Container>
      <StatCounter
        client:visible
        stats={[
          {
            value: new Date().getFullYear() - 2008,
            suffix: "+",
            label: "Years in business",
          },
          { value: 64, suffix: "+", label: "Verified clients" },
          { value: 99, suffix: "%", label: "Customer satisfaction" },
          { value: 3, suffix: "", label: "Office locations" },
        ]}
      />
    </Container>
  </Section>

  <!-- Vision: editorial offset — text block pushed right, illustration left -->
  <Section variant="light">
    <Container>
      <div class="grid items-center gap-14 lg:grid-cols-12">
        <DataPipeline class="hidden w-full max-w-md lg:col-span-5 lg:block" />
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="kicker">Our Vision</p>
          <h2 class="headline-xl mt-4">
            We reshape digital transformation to
            <span class="headline-accent">enrich your business</span>
          </h2>
          <p class="mt-6 text-h5 text-brand-text">
            We are focused on helping brands grow through digital transformation
            services. We bring real solutions to each client's problems through
            a deep understanding of their market, solution, and vision.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- What We Do: dark band, mirrored offset -->
  <Section variant="dark">
    <Container>
      <div class="grid items-center gap-14 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker">What We Do</p>
          <h2 class="headline-xl mt-4">
            We take the heavy lifting
            <span class="headline-accent--on-dark">off your hands</span>
          </h2>
          <p class="mt-6 text-h5 text-brand-light/80">
            We engineer modern innovative IT solutions for businesses of every
            size — with an emphasis on creating value through operational
            excellence and flexible scaling.
          </p>
          <p class="mt-4 text-brand-light/70">
            We take pride in maintaining an open dialogue with every customer.
            Your company goals and growth drive everything from design solutions
            up to final execution plan implementation.
          </p>
          <div class="mt-8">
            <Button href="/solutions/">See All Solutions</Button>
          </div>
        </div>
        <ServerRack
          class="hidden w-full max-w-md justify-self-end lg:col-span-5 lg:col-start-8 lg:block"
        />
      </div>
    </Container>
  </Section>

  <!-- Solutions teaser -->
  <Section variant="light">
    <Container>
      <div class="max-w-3xl">
        <p class="kicker">Solutions</p>
        <h2 class="headline-xl mt-4">
          Innovative IT services designed to
          <span class="headline-accent">supercharge your growth</span>
        </h2>
        <p class="mt-6">
          At Systemizer Technic, we simplify your technology solutions through
          innovative, best-in-class hardware and software support services. Our
          team has the experience and expertise to equip your business with the
          tools and technology to streamline your scalability.
        </p>
        <p class="mt-4">
          It's not just about the technology anymore – it all starts with a
          consultation. Driven by innovation, we offer solutions to help you
          succeed, whether you're looking for IT solutions support, enterprise
          services, or maintenance support services—we've got you covered.
        </p>
        <div class="mt-8">
          <Button href="/solutions/" variant="secondary">
            View All Solutions
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Success Stories: editorial numbered cards -->
  <Section variant="surface">
    <Container>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker">Success Stories</p>
          <h2 class="headline-xl mt-4">Read our success stories</h2>
        </div>
        <Button href="/success-stories/" variant="secondary">
          See all Success Stories
        </Button>
      </div>
      <p class="mt-6 max-w-3xl">
        We have helped countless clients across a broad spectrum of industries
        revolutionize their IT solutions through innovative and leading-edge
        technology. Discover some of them below.
      </p>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          stories.map((story, i) => (
            <li class="group relative rounded-lg border border-brand-surface bg-brand-light p-6 transition-all duration-200 hover:-translate-y-1 hover:border-brand-primary hover:shadow-lg">
              <span class="index-numeral" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-4 text-h5">{story.data.clientName}</h3>
              <p class="mt-3 text-small">
                {truncate(story.data.challenge, 120)}
              </p>
              <p class="mt-4">
                <Button
                  href={`/success-stories/${story.data.slug}/`}
                  variant="ghost"
                  class="px-0"
                >
                  View Success Story
                </Button>
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <!-- Clients: dark closing band -->
  <Section variant="ink">
    <Container>
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker">Clients</p>
          <h2 class="headline-xl mt-4">Clients we have worked for</h2>
        </div>
        <div class="lg:col-span-5">
          <p class="text-brand-light/75">
            We have had the opportunity to work with clients from various
            industries, large and small. We treat each client with the same care
            and attention, to ensure that the service we provide always meets
            their requirements.
          </p>
          <div class="mt-6">
            <Button href="/clients/">Our Clients</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
