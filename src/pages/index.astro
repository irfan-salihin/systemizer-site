---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Systemizer Technic — Leading-edge IT technology services"
  description="Leading-edge IT technology services custom-tailored for your business."
>
  <div class="mx-auto max-w-4xl px-6 py-24">
    <h1 class="text-h1">
      Systemizer Technic Sdn Bhd — website rebuild scaffold
    </h1>
    <p class="mt-4">
      Astro 5 + TypeScript strict + Tailwind CSS 4 scaffold. Placeholder brand
      tokens are wired into the Tailwind theme (see
      <code>src/styles/global.css</code>) pending Phase 10 replacement with
      final brand assets.
    </p>
    <p class="mt-4">
      <a class="underline" href="/style-check/">Design-system style check</a> ·
      <a class="underline" href="https://systemizerinc.com/"
        >Current live site</a
      >
    </p>
  </div>
</BaseLayout>
