---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";

const services = [
  "Infrastructure Audit",
  "Capacity Planning",
  "Technology Roadmap",
  "DR Planning",
  "Cloud Integration",
  "Migration",
  "IT Health Monitoring",
  "IT Decommissioning",
];
---

<PageLayout
  title="IT Consulting"
  tagline="Consultancy is the bridge between challenges and solutions."
  description="Systemizer Technic's IT consulting services align technology strategy with business goals, through strategic, architectural, operational, and implementation planning."
>
  <Section variant="light">
    <Container>
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker">Approach</p>
          <h2 class="headline-xl mt-5">
            Unbiased guidance, grounded in what actually works.
          </h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="text-h5 text-brand-text">
            We assess your current estate, design around emerging technologies,
            and evaluate operational efficiency — advising on deployment based
            on what fits your goals, not the latest trend.
          </p>
          <p class="mt-4 text-body text-brand-text">
            With deep multi-platform experience and no vendor agenda, we work as
            partners in your IT strategy from first audit through to execution.
          </p>
          <div class="mt-8">
            <Button href="/contact/">Request a consultation</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <p class="kicker">Services</p>
      <h2 class="headline-xl mt-5">Our consulting services</h2>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-brand-line bg-brand-line sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service) => (
            <li class="bg-brand-light p-6 text-small font-medium text-brand-secondary">
              {service}
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>
</PageLayout>
