---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";

export async function getStaticPaths() {
  const solutions = await getCollection("solutions");
  return solutions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  tagline={entry.data.tagline}
  description={entry.data.description}
  eyebrow="Solutions"
  icon={entry.data.icon}
>
  <Section variant="light">
    <Container class="prose-like max-w-3xl">
      <Content />
    </Container>
  </Section>
  <Section variant="surface">
    <Container class="flex flex-wrap items-center justify-between gap-4">
      <p class="text-h5 text-brand-secondary">Contact us for a consultation.</p>
      <div class="flex gap-4">
        <Button href="/contact/">Contact Us</Button>
        <Button href="/solutions/" variant="secondary">All Solutions</Button>
      </div>
    </Container>
  </Section>
</PageLayout>
