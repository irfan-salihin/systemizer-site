---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";

export async function getStaticPaths() {
  const solutions = await getCollection("solutions");
  return solutions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  tagline={entry.data.tagline}
  description={entry.data.description}
  eyebrow="Solutions"
  icon={entry.data.icon}
>
  <Section variant="light">
    <Container class="prose-like max-w-3xl">
      <Content />
    </Container>
  </Section>
  <Section variant="ink">
    <Container class="flex flex-wrap items-center justify-between gap-6">
      <p class="headline-xl max-w-xl text-[1.5rem]">
        Let's talk about what this looks like in your environment.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/contact/">Book a consultation</Button>
        <Button href="/solutions/" variant="onDark">All solutions</Button>
      </div>
    </Container>
  </Section>
</PageLayout>
