---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
import CollectionIcon from "../../components/CollectionIcon.astro";
import CapabilityArt from "../../components/illustrations/CapabilityArt.astro";

const solutions = (await getCollection("solutions")).sort(
  (a, b) => a.data.order - b.data.order,
);

const artBySlug: Record<string, "infra" | "automation" | "cloud" | "services"> =
  {
    "st-infra": "infra",
    "st-automation": "automation",
    "st-cloud": "cloud",
    "st-services": "services",
  };

const categories = [
  {
    title: "Automation",
    text: "Remove manual, repeated work from your operations — patching, provisioning, access, and disaster recovery — so systems stay consistent and your team stays focused.",
  },
  {
    title: "Infrastructure & Platform",
    text: "Agile foundations built on virtualisation and hyper-converged infrastructure, designed for continuity and reachable from anywhere.",
  },
  {
    title: "Business Continuity",
    text: "Resilience engineered in from the start, so your business can absorb change and disruption without losing momentum.",
  },
  {
    title: "Managed Services",
    text: "Incident management, onsite support, dedicated resources, and delivery management — best-in-class operations at a cost that improves your bottom line.",
  },
];
---

<PageLayout
  title="Solutions"
  tagline="Modern IT — built right, with you at the centre."
  description="Systemizer Technic delivers infrastructure, automation, cloud, and managed services for Malaysian enterprises and government — multi-platform, vendor-neutral, and accountable end to end."
  heroBackground="lines"
>
  <Section variant="light">
    <Container>
      <div class="max-w-2xl">
        <p class="kicker">The stack</p>
        <h2 class="headline-xl mt-5">One team for the whole stack.</h2>
        <p class="mt-5 text-h5 text-brand-text">
          From the data centre to the cloud to the run-book, Systemizer takes
          ownership of the systems your business depends on.
        </p>
      </div>

      <ol class="mt-14 grid gap-6 md:grid-cols-2">
        {
          solutions.map((solution, i) => (
            <li class="group relative overflow-hidden rounded-2xl border border-brand-line bg-brand-light p-8 transition-all duration-200 hover:-translate-y-1 hover:border-brand-primary hover:shadow-xl">
              <CapabilityArt
                variant={artBySlug[solution.id] ?? "infra"}
                class="pointer-events-none absolute -right-8 -top-6 w-52 opacity-[0.07] transition-opacity duration-300 group-hover:opacity-[0.14]"
              />
              <span
                class="index-numeral absolute right-6 top-5 opacity-40 transition-opacity group-hover:opacity-100"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-surface text-brand-primary-dark ring-1 ring-brand-line">
                <CollectionIcon name={solution.data.icon} class="h-5 w-5" />
              </div>
              <h2 class="mt-6 text-h3 text-brand-secondary">
                {solution.data.title}
              </h2>
              <p class="mt-3 max-w-md text-small text-brand-text">
                {solution.data.tagline}
              </p>
              <p class="mt-6">
                <a
                  href={`/solutions/${solution.id}/`}
                  class="inline-flex items-center gap-2 text-small font-medium text-brand-primary-dark no-underline"
                >
                  Learn more
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-200 group-hover:translate-x-1"
                  >
                    &rarr;
                  </span>
                </a>
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <div class="max-w-2xl">
        <p class="kicker">Capabilities</p>
        <h2 class="headline-xl mt-5">What we take off your plate.</h2>
      </div>
      <div
        class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-brand-line bg-brand-line md:grid-cols-2"
      >
        {
          categories.map((category) => (
            <div class="bg-brand-light p-8">
              <h3 class="text-h4 text-brand-secondary">{category.title}</h3>
              <p class="mt-3 text-small text-brand-text">{category.text}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10">
        <Button href="/contact/">Book a consultation</Button>
      </div>
    </Container>
  </Section>
</PageLayout>
