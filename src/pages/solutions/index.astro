---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";
import Button from "../../components/Button.astro";
import CollectionIcon from "../../components/CollectionIcon.astro";

const solutions = (await getCollection("solutions")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<PageLayout
  title="Solutions"
  tagline="Modern IT — built right with you at the centre."
  description="Systemizer Technic offers a variety of solutions tailored to meet our clients' requirements. With our team's extensive experience, we specialise in handling multi-platform solutions and deployments across different industries."
  heroBackground="mesh-lines"
>
  <Section variant="light">
    <Container class="max-w-3xl">
      <h2 class="text-h2">Let us solve your problems</h2>
      <p class="mt-4">
        We believe that every organization needs to view its IT infrastructure
        development holistically. The functionality and performance of
        Enterprise IT is essential to running a successful business. It supports
        the workforce, helps with day-to-day operations, and provides security
        for sensitive data within your network environment - it's no wonder this
        department has become an integral part of many organizations.
      </p>
      <p class="mt-4">
        Maintaining your enterprise's information technology infrastructure
        requires constant attention from you—but it also offers many
        opportunities to grow through investment-backed services like cloud
        computing, which gives businesses more control over how they securely
        store information.
      </p>
      <p class="mt-4">
        Systemizer Technic offers a variety of solutions tailored to meet our
        clients' requirements. With our team's extensive experience, we
        specialise in handling multi-platform solutions and deployments across
        different industries.
      </p>
    </Container>
  </Section>

  <Section variant="surface">
    <Container>
      <div class="grid gap-6 md:grid-cols-2">
        {
          solutions.map((solution) => (
            <Card>
              <div class="text-brand-primary">
                <CollectionIcon name={solution.data.icon} class="h-9 w-9" />
              </div>
              <h3 class="mt-4 text-h4 uppercase">{solution.data.title}</h3>
              <p class="mt-3">{solution.data.description}</p>
              <p class="mt-4">
                <Button
                  href={`/solutions/${solution.id}/`}
                  variant="ghost"
                  class="px-0"
                >
                  Learn More &gt;
                </Button>
              </p>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Migrated from the live Solutions page: the four capability areas below are
       static copy on the live page (not tied to collection entries). -->
  <Section variant="light">
    <Container>
      <h2 class="text-h2">Solution Categories</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <Card>
          <h3 class="text-h4">Automation</h3>
          <p class="mt-3">
            Automation is a critical factor that determines the efficiency and
            effectiveness of an enterprise's IT infrastructure. Automating your
            processes ensures that repeated, time-consuming tasks are taken care
            of so your employees can increase productivity.
          </p>
          <p class="mt-3">
            Leading-edge automation technology ensure that your business stays
            ahead of the curve no matter what comes your way.
          </p>
        </Card>
        <Card>
          <h3 class="text-h4">Infrastructure / Platform</h3>
          <p class="mt-3">
            Without the proper infrastructure, your business cannot maintain
            continuity. Our team specializes in providing infrastructure as a
            service solution designed to create an agile infrastructure
            foundation.
          </p>
          <p class="mt-3">
            Deploying virtualized servers with HCI (hyper-converged
            infrastructures) so they're easily accessible from any device
            without having unnecessary hassle searching out individual devices
            within your data centre is critical to business continuity and
            streamlined operations.
          </p>
        </Card>
        <Card>
          <h3 class="text-h4">Business Continuity</h3>
          <p class="mt-3">
            Without effective, seamless business continuity solutions, when
            things go wrong or need to change quickly due to any unforeseen
            disaster, your business can't pivot. We help keep your business
            agile every step of the way.
          </p>
          <p class="mt-3">
            Systemizer's powerful technologies and solutions can help any
            organization plan its IT and get the most out of it.
          </p>
        </Card>
        <Card>
          <h3 class="text-h4">Managed Services</h3>
          <p class="mt-3">
            We understand how important it is for companies to manage their
            costs while maintaining their IT infrastructure in the best working
            condition. We draw from our vast experience and qualified team to
            provide best-in-class services at a cost that will improve your
            bottom line.
          </p>
          <p class="mt-3">
            Our Managed Services Include: Incident Management · Labour · Onsite
            Support &amp; Maintenance · Dedicated Resources · Client Delivery
            Management
          </p>
        </Card>
      </div>
      <p class="mt-8">
        <Button href="/contact/">Contact Us For A Consultation</Button>
      </p>
    </Container>
  </Section>
</PageLayout>
