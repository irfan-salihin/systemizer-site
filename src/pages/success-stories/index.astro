---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";

const stories = await getCollection("success-stories");
const [featured, ...rest] = stories;
const truncate = (s: string, n: number) =>
  s.length > n ? s.slice(0, s.lastIndexOf(" ", n)) + "…" : s;
---

<PageLayout
  title="Success Stories"
  tagline="Read our Success Stories"
  description="We have helped countless clients across a broad spectrum of industries revolutionize their IT solutions through innovative and leading-edge technology."
>
  <Section variant="light">
    <Container>
      <p class="max-w-3xl">
        We have helped countless clients across a broad spectrum of industries
        revolutionize their IT solutions through innovative and leading-edge
        technology. Discover some of them below.
      </p>

      <!-- Featured story: full-width editorial lead card -->
      {
        featured && (
          <a
            href={`/success-stories/${featured.data.slug}/`}
            class="group mt-10 grid overflow-hidden rounded-lg border border-brand-surface bg-brand-dark no-underline transition-all duration-200 hover:-translate-y-1 hover:shadow-2xl lg:grid-cols-12"
          >
            <div class="relative p-10 lg:col-span-7">
              <p class="kicker kicker--on-dark">Featured story</p>
              <h2 class="headline-xl mt-4 text-brand-light">
                {featured.data.clientName}
              </h2>
              <p class="mt-2 text-small font-medium uppercase tracking-wider text-brand-light/70">
                {featured.data.industry}
              </p>
              <p class="mt-5 max-w-xl text-brand-light/80">
                {truncate(featured.data.challenge, 240)}
              </p>
              <span class="mt-6 inline-flex items-center gap-2 font-medium text-brand-light underline underline-offset-4">
                View Success Story
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
            <div
              class="hidden items-center justify-center bg-brand-secondary/40 lg:col-span-5 lg:flex"
              aria-hidden="true"
            >
              <span class="index-numeral text-[8rem]">01</span>
            </div>
          </a>
        )
      }

      <!-- Remaining stories: numbered editorial cards -->
      <ol class="mt-6 grid gap-6 md:grid-cols-2">
        {
          rest.map((story, i) => (
            <li class="group relative rounded-lg border border-brand-surface bg-brand-light p-8 transition-all duration-200 hover:-translate-y-1 hover:border-brand-primary hover:shadow-xl">
              <span class="index-numeral" aria-hidden="true">
                {String(i + 2).padStart(2, "0")}
              </span>
              <h3 class="mt-4 text-h4">{story.data.clientName}</h3>
              <p class="mt-1 text-small font-medium uppercase tracking-wider text-brand-primary-dark">
                {story.data.industry}
              </p>
              <p class="mt-3 text-small">
                {truncate(story.data.challenge, 160)}
              </p>
              <p class="mt-5">
                <Button
                  href={`/success-stories/${story.data.slug}/`}
                  variant="ghost"
                  class="px-0"
                >
                  View Success Story
                </Button>
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>
</PageLayout>
