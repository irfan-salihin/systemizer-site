---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";

const stories = await getCollection("success-stories");
const [featured, ...rest] = stories;
const truncate = (s: string, n: number) =>
  s.length > n ? s.slice(0, s.lastIndexOf(" ", n)) + "…" : s;
---

<PageLayout
  title="Success Stories"
  tagline="Read our Success Stories"
  description="We have helped countless clients across a broad spectrum of industries revolutionize their IT solutions through innovative and leading-edge technology."
>
  <Section variant="light" class="pt-8 md:pt-10">
    <Container>
      <!-- Featured story: full-width editorial lead card -->
      {
        featured && (
          <a
            href={`/success-stories/${featured.data.slug}/`}
            class="group grid overflow-hidden rounded-2xl border border-brand-line bg-brand-ink no-underline transition-all duration-200 hover:-translate-y-1 hover:shadow-2xl lg:grid-cols-12"
          >
            <div class="relative p-10 lg:col-span-7">
              <p class="kicker kicker--on-dark">Featured story</p>
              <h2 class="headline-xl mt-5 text-brand-light">
                {featured.data.clientName}
              </h2>
              <p class="tech-label mt-3 text-brand-light/60">
                {featured.data.industry}
              </p>
              <p class="mt-5 max-w-xl text-body text-brand-light/70">
                {truncate(featured.data.challenge, 240)}
              </p>
              <span class="mt-7 inline-flex items-center gap-2 text-small font-medium text-brand-light">
                Read the story
                <span
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-1"
                >
                  &rarr;
                </span>
              </span>
            </div>
            <div
              class="hidden items-center justify-center bg-brand-light/[0.04] lg:col-span-5 lg:flex"
              aria-hidden="true"
            >
              <span class="index-numeral text-[8rem]">01</span>
            </div>
          </a>
        )
      }

      <!-- Remaining stories: numbered editorial cards -->
      <ol class="mt-8 grid gap-6 md:grid-cols-2">
        {
          rest.map((story, i) => (
            <li class="group relative rounded-2xl border border-brand-line bg-brand-light p-8 transition-all duration-200 hover:-translate-y-1 hover:border-brand-primary hover:shadow-xl">
              <span class="index-numeral" aria-hidden="true">
                {String(i + 2).padStart(2, "0")}
              </span>
              <h3 class="mt-4 text-h4 text-brand-secondary">
                {story.data.clientName}
              </h3>
              <p class="tech-label mt-2 text-brand-primary-dark">
                {story.data.industry.split("(")[0].trim()}
              </p>
              {story.data.resultStat && (
                <p class="mt-4">
                  <span class="block font-heading text-h2 font-semibold text-brand-primary">
                    {story.data.resultStat}
                  </span>
                  <span class="mt-1 block text-small text-brand-text">
                    {story.data.resultLabel}
                  </span>
                </p>
              )}
              <p class="mt-5">
                <a
                  href={`/success-stories/${story.data.slug}/`}
                  class="inline-flex items-center gap-2 text-small font-medium text-brand-primary-dark no-underline"
                >
                  Read the story
                  <span
                    aria-hidden="true"
                    class="transition-transform duration-200 group-hover:translate-x-1"
                  >
                    &rarr;
                  </span>
                </a>
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>
</PageLayout>
